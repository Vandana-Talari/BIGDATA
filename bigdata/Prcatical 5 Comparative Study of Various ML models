Take the inbuilt data file: iris and perform classification on that data using various classification models – Decision Tree, K Nearest Neighbour and Support Vector Machine. Find the confusion matrix for all three models and evaluate them by finding their accuracy. Find the algorithm which performs best on the given data file, out of all these three models.

Code:-
install.packages('rpart')
install.packages('rpart.plot')
install.packages('gmodels')
install.packages('e1071')
install.packages('caTools')
install.packages('class')

library(rpart)
library(rpart.plot)
library(gmodels)
library(e1071)
library(caTools)
library(class)

# --- Step 2: Dataset Load karna ---
data(iris)
summary(iris)

# --- Step 3: Data Normalization ---
# Continuous variables ko scale karna taaki analysis sahi ho
temp = as.data.frame(scale(iris[,1:4]))
temp$Species = iris$Species
summary(temp)

# --- Step 4: Data Splitting ---
# Training set (75%) aur Test set (25%) mein divide karna
set.seed(123)
split = sample.split(temp$Species, SplitRatio = 0.75)
train = subset(temp, split == TRUE)
test = subset(temp, split == FALSE)

# Check rows
nrow(train)
nrow(test)

# --- Step 5: Model 1 - Decision Tree ---
dt_classifier = rpart(formula = Species ~ ., data = train)
# Predicting results
dt_y_pred = predict(dt_classifier, newdata = test, type = 'class')
print(dt_y_pred)
# Confusion Matrix
cm_dt = table(test$Species, dt_y_pred)
print(cm_dt)
# Accuracy calculation
DTaccu = ((12+9+11)/nrow(test))*100
print(paste("Decision Tree Accuracy: ", DTaccu))

# --- Step 6: Model 2 - k-Nearest Neighbours (kNN) ---
cl = train$Species
set.seed(1234)
knn_y_pred = knn(train[,1:4], test[,1:4], cl, k=5)
# Confusion Matrix
cm_knn = table(test$Species, knn_y_pred)
print(cm_knn)
# Accuracy calculation
KNNaccu = ((12+11+11)/nrow(test))*100
print(paste("kNN Accuracy: ", KNNaccu))

# --- Step 7: Model 3 - Support Vector Machine (SVM) ---
svmclassifier = svm(Species ~ . , data = train)
svm_y_pred = predict(svmclassifier, newdata = test)
# Confusion Matrix
cm_svm = table(test$Species, svm_y_pred)
print(cm_svm)
# Accuracy calculation
SVMaccu = ((12+11+11)/nrow(test))*100
print(paste("SVM Accuracy: ", SVMaccu))

# --- Step 8: Comparison Table ---
# Teeno models ki accuracy ko ek frame mein dekhna
models = data.frame(
  Technique = c("Decision Tree", "kNN", "SVM"),
  Accuracy_Percentage = c(88.88889, 94.44444, 94.44444)
)
print(models)
